shell-integration = zsh
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
window-padding-x = 4,4
window-padding-y = 2,4
keybind = ctrl+slash=text:/
keybind = shift+ctrl+slash=text:?
background-opacity = 0.90
background-blur-radius = 24

# Auto-switch with macOS appearance using TokyoNight
# Built-in Ghostty themes
theme = light:TokyoNight Day,dark:TokyoNight Night
