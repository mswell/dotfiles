#!/usr/bin/env bash
set -euo pipefail

THEME_DIR="$HOME/.pi/agent/themes"
THEME_FILE="$THEME_DIR/tokyonight.json"
STATE_FILE="$HOME/.pi/agent/.tokyonight-system-mode"

mkdir -p "$THEME_DIR"

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi '^Dark$'; then
  mode="dark"
else
  mode="light"
fi

# Avoid touching the active theme unless the system appearance changed.
if [[ -f "$STATE_FILE" ]] && [[ "$(cat "$STATE_FILE" 2>/dev/null || true)" == "$mode" ]]; then
  exit 0
fi

tmp="$(mktemp "${THEME_FILE}.XXXXXX")"

if [[ "$mode" == "dark" ]]; then
  cat > "$tmp" <<'JSON'
{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "tokyonight",
  "vars": {
    "bg": "#1a1b26",
    "panelDark": "#16161e",
    "panel": "#1f2335",
    "panelAlt": "#24283b",
    "surface": "#292e42",
    "border": "#3b4261",
    "fg": "#c0caf5",
    "fgMuted": "#a9b1d6",
    "comment": "#7f8bbf",
    "blue": "#7aa2f7",
    "purple": "#bb9af7",
    "cyan": "#7dcfff",
    "teal": "#73daca",
    "green": "#9ece6a",
    "red": "#f7768e",
    "orange": "#ff9e64",
    "yellow": "#e0af68",
    "successBg": "#1b2a22",
    "errorBg": "#2a1f28"
  },
  "colors": {
    "accent": "blue",
    "border": "border",
    "borderAccent": "blue",
    "borderMuted": "border",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "fgMuted",
    "dim": "comment",
    "text": "fg",
    "thinkingText": "fgMuted",
    "selectedBg": "surface",
    "userMessageBg": "panel",
    "userMessageText": "fg",
    "customMessageBg": "panelAlt",
    "customMessageText": "fg",
    "customMessageLabel": "purple",
    "toolPendingBg": "panelDark",
    "toolSuccessBg": "panel",
    "toolErrorBg": "errorBg",
    "toolTitle": "fg",
    "toolOutput": "fgMuted",
    "mdHeading": "yellow",
    "mdLink": "blue",
    "mdLinkUrl": "comment",
    "mdCode": "cyan",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "comment",
    "mdQuote": "fgMuted",
    "mdQuoteBorder": "border",
    "mdHr": "border",
    "mdListBullet": "blue",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "fgMuted",
    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "blue",
    "syntaxVariable": "fg",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "teal",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "cyan",
    "thinkingOff": "border",
    "thinkingMinimal": "comment",
    "thinkingLow": "blue",
    "thinkingMedium": "cyan",
    "thinkingHigh": "purple",
    "thinkingXhigh": "red",
    "bashMode": "green"
  },
  "export": {
    "pageBg": "bg",
    "cardBg": "panel",
    "infoBg": "surface"
  }
}
JSON
else
  cat > "$tmp" <<'JSON'
{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "tokyonight",
  "vars": {
    "bg": "#e1e2e7",
    "panelDark": "#cfd3e6",
    "panel": "#d8dbe8",
    "panelAlt": "#d0d5ea",
    "surface": "#c4c8da",
    "border": "#a1a6c5",
    "fg": "#3760bf",
    "fgMuted": "#6172b0",
    "comment": "#848cb5",
    "blue": "#2e7de9",
    "purple": "#9854f1",
    "cyan": "#007197",
    "teal": "#007197",
    "green": "#587539",
    "red": "#f52a65",
    "orange": "#b15c00",
    "yellow": "#8c6c3e",
    "successBg": "#d7e3ce",
    "errorBg": "#ead5dc"
  },
  "colors": {
    "accent": "blue",
    "border": "border",
    "borderAccent": "blue",
    "borderMuted": "border",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "fgMuted",
    "dim": "comment",
    "text": "fg",
    "thinkingText": "fgMuted",
    "selectedBg": "surface",
    "userMessageBg": "panel",
    "userMessageText": "fg",
    "customMessageBg": "panelAlt",
    "customMessageText": "fg",
    "customMessageLabel": "purple",
    "toolPendingBg": "panelDark",
    "toolSuccessBg": "#d7e3ce",
    "toolErrorBg": "errorBg",
    "toolTitle": "fg",
    "toolOutput": "fgMuted",
    "mdHeading": "yellow",
    "mdLink": "blue",
    "mdLinkUrl": "comment",
    "mdCode": "cyan",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "comment",
    "mdQuote": "fgMuted",
    "mdQuoteBorder": "border",
    "mdHr": "border",
    "mdListBullet": "blue",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "fgMuted",
    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "blue",
    "syntaxVariable": "fg",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "teal",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "cyan",
    "thinkingOff": "border",
    "thinkingMinimal": "comment",
    "thinkingLow": "blue",
    "thinkingMedium": "cyan",
    "thinkingHigh": "purple",
    "thinkingXhigh": "red",
    "bashMode": "green"
  },
  "export": {
    "pageBg": "bg",
    "cardBg": "panel",
    "infoBg": "surface"
  }
}
JSON
fi

python3 -m json.tool "$tmp" >/dev/null
mv "$tmp" "$THEME_FILE"
printf '%s' "$mode" > "$STATE_FILE"
